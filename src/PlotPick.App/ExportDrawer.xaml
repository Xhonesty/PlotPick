<UserControl x:Class="PlotPick.App.ExportDrawer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AllowDrop="True">
<Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><TextBlock Text="导出数据" FontSize="18" FontWeight="SemiBold"/><Button Content="×" HorizontalAlignment="Right" Click="CloseClick" Style="{StaticResource Quiet}" ToolTip="关闭导出设置"/></DockPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="导出范围" Style="{StaticResource Label}"/><ComboBox x:Name="Scope" SelectionChanged="ScopeChanged" AutomationProperties.AutomationId="ExportScope"><ComboBoxItem Content="当前系列"/><ComboBoxItem Content="勾选系列"/><ComboBoxItem Content="当前图表"/><ComboBoxItem Content="整个项目"/></ComboBox>
<ItemsControl x:Name="SeriesChoices" Margin="4,4" MaxHeight="150"><ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding Count}" Foreground="#94A3B8" FontSize="11" DockPanel.Dock="Right"/><CheckBox IsChecked="{Binding Selected}" Click="SeriesCheck" Margin="5,3" ToolTip="{Binding Source}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis"/></StackPanel></CheckBox></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="文件格式" Style="{StaticResource Label}"/><ComboBox x:Name="FormatBox" SelectionChanged="FormatChanged"><ComboBoxItem Content="Excel (.xlsx)"/><ComboBoxItem Content="CSV (.csv)"/><ComboBoxItem Content="TSV (.tsv)"/><ComboBoxItem Content="文本 (.txt)"/><ComboBoxItem Content="JSON (.json)"/></ComboBox>
</StackPanel><StackPanel Grid.Column="1"><TextBlock Text="表格布局" Style="{StaticResource Label}"/><ComboBox x:Name="LayoutBox" SelectionChanged="OptionChanged" AutomationProperties.AutomationId="ExportLayout"><ComboBoxItem Content="分系列工作表"/><ComboBoxItem Content="独立 XY 列对"/><ComboBoxItem Content="共用 X 宽表"/><ComboBoxItem Content="长表"/></ComboBox>
</StackPanel></Grid>
<DockPanel Margin="4,12,4,2"><TextBlock Text="选择导出列" FontWeight="SemiBold"/><ComboBox x:Name="Preset" Width="118" HorizontalAlignment="Right" SelectionChanged="PresetChanged"><ComboBoxItem Content="简洁数据"/><ComboBoxItem Content="多系列对比"/><ComboBoxItem Content="完整记录"/><ComboBoxItem Content="自定义"/></ComboBox></DockPanel>
<ListBox x:Name="ColumnsList" Height="175" AllowDrop="True" Drop="ColumnDrop" PreviewMouseLeftButtonDown="ColumnMouseDown" PreviewMouseMove="ColumnMouseMove" AutomationProperties.AutomationId="ExportColumns"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⠿" Tag="drag" Foreground="#94A3B8" Cursor="SizeAll" ToolTip="拖动调整导出列顺序"/><CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" Click="ColumnCheck" Margin="2" ToolTip="{Binding Key}"/><TextBox Grid.Column="2" Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" LostFocus="ColumnRenamed" Margin="1" Padding="4,3" ToolTip="编辑导出列名"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<DockPanel Margin="4,2"><TextBlock Text="勾选列 · 可改名、拖动排序" Foreground="#94A3B8" FontSize="10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↑" Click="ColumnUp" Padding="7,0" MinHeight="24" ToolTip="所选列上移"/><Button Content="↓" Click="ColumnDown" Padding="7,0" MinHeight="24" ToolTip="所选列下移"/></StackPanel></DockPanel>
<Expander Header="检查状态与 X 对齐" Margin="4,10"><StackPanel><CheckBox x:Name="AcceptedOnly" Content="仅导出已检查的数据点" Click="OptionChanged"/><TextBlock Text="批量处理数据始终只导出已检查点。" Foreground="#94A3B8" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="共用 X：匹配绝对容差" Style="{StaticResource Label}"/><TextBox x:Name="XTolerance" Text="0.00000001" LostFocus="OptionChanged"/><CheckBox x:Name="Resample" Content="共用 X 时临时线性重采样" Click="OptionChanged"/><TextBlock Text="只处理 X/Y，共同范围内插值，不外推。原数据不变。日期轴间距单位为天。" TextWrapping="Wrap" Foreground="#64748B" FontSize="11"/><TextBox x:Name="ResampleStep" Text="0.1" LostFocus="OptionChanged" ToolTip="重采样间距"/></StackPanel></Expander>
<Button Content="保存为个人导出预设" Click="SavePresetClick"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" BorderBrush="#E4E9F0" BorderThickness="0,1,0,0" Padding="0,8,0,0"><StackPanel><DockPanel Margin="4,0"><TextBlock Text="保存数据的有效数字" FontWeight="SemiBold"/><TextBox x:Name="Digits" Text="17" Width="48" HorizontalAlignment="Right" TextChanged="DigitsChanged" AutomationProperties.AutomationId="SignificantDigits" ToolTip="输入 1–17，控制导出数值的有效数字位数"/></DockPanel><DockPanel Margin="4,0"><TextBlock Text="1–17 位 · 默认完整精度" FontSize="10" Foreground="#64748B"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="3 位" Tag="3" Click="PrecisionPresetClick" Padding="5,1" MinHeight="24"/><Button Content="6 位" Tag="6" Click="PrecisionPresetClick" Padding="5,1" MinHeight="24"/><Button Content="17 位" Tag="17" Click="PrecisionPresetClick" Padding="5,1" MinHeight="24"/></StackPanel></DockPanel><CheckBox x:Name="PadZeros" Content="补齐末尾零（如 3 位：1.2 → 1.20）" Margin="4,4" FontSize="11" Click="PrecisionChanged"/><TextBlock Text="影响导出文件和复制；项目原始坐标保持完整精度。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="4,2"/><DockPanel Margin="4,8"><TextBlock Text="导出预览" FontWeight="SemiBold"/><ComboBox x:Name="PreviewSheet" SelectionChanged="PreviewSheetChanged" HorizontalAlignment="Right" MaxWidth="175" ToolTip="切换预览工作表"/></DockPanel>
<DataGrid x:Name="PreviewGrid" Height="96" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" BorderBrush="#E4E9F0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F6" Background="White" RowHeight="25" FontSize="11" AutomationProperties.AutomationId="ExportPreview"/>
<TextBlock x:Name="Notice" MaxHeight="40" TextWrapping="Wrap" FontSize="11" Foreground="#64748B" Margin="4,8"/>
<TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="4,3"/><TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#BE123C" FontSize="11" Margin="4,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Button x:Name="ExportButton" Content="导出 Excel" Click="WriteClick" Style="{StaticResource Primary}" AutomationProperties.AutomationId="ConfirmExport"/><Button Grid.Column="1" Content="复制" Click="CopyClick" AutomationProperties.AutomationId="CopyExport" ToolTip="复制当前布局中唯一的表；多表请切换独立列对或长表"/></Grid></StackPanel></Border>
</Grid></UserControl>
